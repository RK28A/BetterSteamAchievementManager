<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>BetterSteamAchievementManager</AssemblyName>
    <Version>8.0.0</Version>
    <ApplicationIcon>..\SAM.Picker\SAM.ico</ApplicationIcon>
    <ApplicationManifest>..\SAM.Picker\app.manifest</ApplicationManifest>
    <OutputPath>..\dist\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <EmbeddedResource Include="..\upload\*.exe;..\upload\*.dll;..\upload\*.config;..\LICENSE.txt;..\README.md">
      <LogicalName>Payload.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="RequirePayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('..\upload\SAM.Picker.exe') or !Exists('..\upload\SAM.Game.exe')" Text="Build SAM.sln in Release x86 before building the launcher." />
  </Target>
</Project>
